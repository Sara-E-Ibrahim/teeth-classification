test_dir = "/kaggle/working/Teeth_Dataset/Testing"
train_dir = "/kaggle/working/Teeth_Dataset/Training"
val_dir   = "/kaggle/working/Teeth_Dataset/Validation"



import os
import shutil

keep = set(['CaS','CoS','Gum','MC','OC','OLP','OT'])

for item in os.listdir(test_dir):
    path = os.path.join(test_dir, item)

   
    if item not in keep:
        if os.path.isdir(path):
            shutil.rmtree(path)      
            print("Deleted folder:", path)
        else:
            os.remove(path)          
            print("Deleted file:", path)



IMG_SIZE = (128, 128)
BATCH_SIZE = 32

train_ds = tf.keras.preprocessing.image_dataset_from_directory(
    train_dir,
    image_size=IMG_SIZE,
    batch_size=BATCH_SIZE,
    shuffle=True
)

val_ds = tf.keras.preprocessing.image_dataset_from_directory(
    val_dir,
    image_size=IMG_SIZE,
    batch_size=BATCH_SIZE,
    shuffle=False
)

test_ds = tf.keras.preprocessing.image_dataset_from_directory(
    test_dir,
    image_size=IMG_SIZE,
    batch_size=BATCH_SIZE,
    shuffle=False
)


class_names = test_ds.class_names
print(class_names)


import matplotlib.pyplot as plt

def visualize_samples(dataset, class_names, num_images=9):
    plt.figure(figsize=(10, 10))
    # Take 1 batch
    for images, labels in dataset.take(1):
        for i in range(num_images):
            ax = plt.subplot(int(num_images**0.5), int(num_images**0.5), i + 1)
            plt.imshow(images[i].numpy().astype("uint8"))
            plt.title(class_names[labels[i]])
            plt.axis("off")
    plt.show()



visualize_samples(train_ds, train_ds.class_names)


AUTOTUNE = tf.data.AUTOTUNE

train_ds = train_ds.cache().shuffle(1000).prefetch(buffer_size=AUTOTUNE)
val_ds = val_ds.cache().prefetch(buffer_size=AUTOTUNE)
test_ds = test_ds.cache().prefetch(buffer_size=AUTOTUNE)



from tensorflow.keras import layers

data_augmentation = tf.keras.Sequential([
    layers.RandomFlip("horizontal"),
    layers.RandomRotation(0.05),  
    layers.RandomZoom(0.1),
    layers.RandomContrast(0.1)
])



train_ds = train_ds.map(lambda x, y: (data_augmentation(x), y))


from tensorflow.keras import layers, models

IMG_SIZE = (128, 128, 3)

model = models.Sequential([
    layers.Rescaling(1./255, input_shape=IMG_SIZE),  # <--- normalization layer
    layers.Conv2D(64, (3,3), activation='relu'),
    layers.MaxPooling2D(),
    layers.Conv2D(128, (3,3), activation='relu'),
    layers.MaxPooling2D(),
    layers.Conv2D(128, (3,3), activation='relu'),
    layers.MaxPooling2D(),
    layers.Conv2D(256, (3,3), activation='relu'),
    layers.MaxPooling2D(),
    layers.Flatten(),
    layers.Dense(64, activation='relu'),
    layers.Dropout(0.5),
    layers.Dense(7, activation='softmax')  # 7 classes in your dataset
])
model.summary()


tf.keras.utils.plot_model(model,rankdir='LR',show_dtype=True)


model.compile(
    optimizer='adam',
    loss='sparse_categorical_crossentropy',  
    metrics=['accuracy']
)



from tensorflow.keras.callbacks import EarlyStopping

EPOCHS = 70  
early_stop = EarlyStopping(
    monitor='val_loss',   
    patience=5,           
    restore_best_weights=True  
)

history = model.fit(
    train_ds,             
    validation_data=val_ds,  
    epochs=EPOCHS,
    callbacks=[early_stop]   
)



import matplotlib.pyplot as plt

plt.plot(history.history['accuracy'], label='train_acc')
plt.plot(history.history['val_accuracy'], label='val_acc')
plt.legend()
plt.show()



test_loss, test_acc = model.evaluate(test_ds)
print(f"Test Accuracy: {test_acc*100:.2f}%")


# Save the entire model
model.save("teeth_model.h5")  



# Get predicted class probabilities
y_pred_probs = model.predict(test_ds)

# Convert probabilities to class indices
y_pred = np.argmax(y_pred_probs, axis=1)



y_true = np.concatenate([y for x, y in test_ds], axis=0)



print(classification_report(y_true, y_pred, target_names=class_names))


cm = confusion_matrix(y_true, y_pred)

plt.figure(figsize=(8,6))
sns.heatmap(cm, annot=True, fmt="d", xticklabels=class_names, yticklabels=class_names)
plt.xlabel("Predicted")
plt.ylabel("True")
plt.show()


